<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + site.title) if title else (site.title + " | " + site.tagline) %}
  {% set pageDesc = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/article.njk' else 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' }}">
  <link rel="icon" href="{{ '/favicon.svg' }}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' }}">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="{{ '/' }}">
        <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 4 7v8c0 7.5 5.1 13.4 12 15 6.9-1.6 12-7.5 12-15V7L16 2z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="m11 16 3.5 3.5L21 13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ site.title }}</span>
      </a>
      <nav aria-label="Primary">
        <a href="{{ '/articles/' }}" {% if page.url.startsWith('/articles') %}aria-current="page"{% endif %}>Articles</a>
        <a href="{{ '/topics/' }}" {% if page.url == '/topics/' %}aria-current="page"{% endif %}>Topics</a>
        <a href="{{ '/start-here/' }}" {% if page.url == '/start-here/' %}aria-current="page"{% endif %}>Start here</a>
        <a href="{{ '/about/' }}" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>
        {% if site.mainSite.url != "https://example.com" %}<a class="ext" href="{{ site.mainSite.url }}">{{ site.mainSite.label }} ↗</a>{% endif %}
      </nav>
    </div>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p><strong>{{ site.title }}</strong> · {{ site.tagline }}</p>
      <p class="muted">Articles are reviewed periodically to stay current. Content is educational and is not legal or audit advice.</p>
      <p class="muted"><a href="{{ '/feed.xml' }}">RSS feed</a> · <a href="{{ '/sitemap.xml' }}">Sitemap</a>{% if site.mainSite.url != "https://example.com" %} · <a href="{{ site.mainSite.url }}">{{ site.mainSite.label }}</a>{% endif %} · © {{ year }} {{ site.author }}</p>
    </div>
  </footer>
</body>
</html>
